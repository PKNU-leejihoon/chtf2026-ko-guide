{
  "name": "chtf2026-field-presence",
  "main": "worker.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "VenueRoom" }, { "name": "MEETINGS", "class_name": "MeetingReminder" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VenueRoom"] }, { "tag": "v2", "new_sqlite_classes": ["MeetingReminder"] }],
  "ratelimits": [
    { "name": "REQUESTS", "namespace_id": "20261126", "simple": { "limit": 600, "period": 60 } }
  ]
}
